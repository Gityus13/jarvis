# ═══ J.A.R.V.I.S. configuration ═══════════════════════════════════════════════
# Copy to .env and edit. Everything is optional except a working Ollama model.

# ── AI engine (Ollama) ─────────────────────────────────────────────────────────
# Run `ollama list` to see what you have. Any chat model works (llama3.2, qwen2.5, mistral, gpt-oss …).
# Cloud models (names ending in -cloud) need one-time `ollama signin`.
OLLAMA_MODEL=gpt-oss:120b-cloud
OLLAMA_URL=http://localhost:11434

# ── About you ──────────────────────────────────────────────────────────────────
USER_NAME=                 # what JARVIS calls you. Empty = "sir"
HOME_CITY=                 # weather + briefing. Empty = detected from your IP (or say: "set my city to Paris")
HOME_CURRENCY=USD          # shown against USD/EUR in the markets panel, e.g. EUR, GBP, TRY, AZN
UNITS=metric               # metric | imperial

# ── Voice output ───────────────────────────────────────────────────────────────
# Order of preference: Kokoro (free neural voice, auto-used if installed) → ElevenLabs → your system voice.
# KOKORO=off               # uncomment to disable Kokoro
# KOKORO_DTYPE=q8          # q8 (default, ~90 MB) | fp32 | fp16 | q4
# HF_ENDPOINT=https://hf-mirror.com    # if huggingface.co is blocked where you are
KOKORO_VOICE_JARVIS=bm_george
KOKORO_VOICE_FRIDAY=bf_emma
KOKORO_VOICE_ULTRON=am_onyx

ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_JARVIS=onwK4e9ZLuTAKqWW03F9
ELEVENLABS_VOICE_FRIDAY=21m00Tcm4TlvDq8ikWAM
ELEVENLABS_VOICE_ULTRON=AZnzlk1XvdvUeBnXmlld

# Preferred system voices for the fallback voice (macOS: run `say -v '?'` to list them)
JARVIS_VOICE=Daniel
FRIDAY_VOICE=Moira
ULTRON_VOICE=Alex

# ── Server ─────────────────────────────────────────────────────────────────────
PORT=3000
# JARVIS can type, click and run apps on your computer, so it only accepts connections from
# THIS machine. To use it from another device on your LAN (never the internet!):
# HOST=0.0.0.0
# ALLOWED_HOSTS=192.168.1.20
