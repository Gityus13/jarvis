# ─── J.A.R.V.I.S. Configuration ──────────────────────────────────────────────

# Ollama model — run: ollama list  to see available models
OLLAMA_MODEL=gpt-oss:120b-cloud

# Ollama server URL
OLLAMA_URL=http://localhost:11434

# ElevenLabs (optional — leave blank to use Kokoro / your system voices)
ELEVENLABS_API_KEY=

# ElevenLabs voice IDs per personality (optional, defaults are preset)
ELEVENLABS_VOICE_JARVIS=onwK4e9ZLuTAKqWW03F9
ELEVENLABS_VOICE_FRIDAY=21m00Tcm4TlvDq8ikWAM
ELEVENLABS_VOICE_ULTRON=AZnzlk1XvdvUeBnXmlld

# Preferred system voice names for the browser voice (run: say -v '?' on macOS to list them)
JARVIS_VOICE=Daniel
FRIDAY_VOICE=Moira
ULTRON_VOICE=Alex

# Kokoro (optional, free, local) — auto-used if installed (npm i kokoro-js), otherwise normal voice
# KOKORO=off                # uncomment to disable
# KOKORO_DTYPE=q8           # q8 (default, ~90MB) | fp32 | fp16 | q4
KOKORO_VOICE_JARVIS=bm_george
KOKORO_VOICE_FRIDAY=bf_emma
KOKORO_VOICE_ULTRON=am_onyx

# Server port
PORT=3000

# Network — by default JARVIS only accepts connections from THIS computer (it controls your
# keyboard, mouse and apps, so never expose it). To use it from another device on your LAN:
# HOST=0.0.0.0
# ALLOWED_HOSTS=192.168.1.20
