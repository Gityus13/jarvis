# ─── J.A.R.V.I.S. Configuration ──────────────────────────────────────────────

# Ollama model — run: ollama list  to see available models
OLLAMA_MODEL=gpt-oss:120b-cloud

# Ollama server URL
OLLAMA_URL=http://localhost:11434

# ElevenLabs (optional — leave blank to use macOS say / browser TTS)
ELEVENLABS_API_KEY=

# ElevenLabs voice IDs per personality (optional, defaults are preset)
ELEVENLABS_VOICE_JARVIS=onwK4e9ZLuTAKqWW03F9
ELEVENLABS_VOICE_FRIDAY=21m00Tcm4TlvDq8ikWAM
ELEVENLABS_VOICE_ULTRON=AZnzlk1XvdvUeBnXmlld

# macOS voices (run: say -v '?' to list all)
JARVIS_VOICE=Daniel
FRIDAY_VOICE=Moira
ULTRON_VOICE=Alex

# Speech rate for macOS say
JARVIS_VOICE_RATE=175

# Server port
PORT=3000
