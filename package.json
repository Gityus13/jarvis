{
  "name": "jarvis",
  "version": "4.0.9",
  "description": "J.A.R.V.I.S. — a private tactical AI console: local LLM, voice in/out, live intel, system telemetry and Mac control. No API keys.",
  "main": "electron/main.js",
  "license": "MIT",
  "author": "Gityus13",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Gityus13/jarviis.git"
  },
  "bugs": {
    "url": "https://github.com/Gityus13/jarviis/issues"
  },
  "homepage": "https://github.com/Gityus13/jarviis#readme",
  "keywords": [
    "jarvis",
    "ai-assistant",
    "voice-assistant",
    "ollama",
    "local-llm",
    "kokoro",
    "tts",
    "macos",
    "automation",
    "hud"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "test": "node --test test/*.test.js",
    "doctor": "node scripts/doctor.js",
    "kokoro-test": "node scripts/kokoro-test.js",
    "setup": "bash setup.sh",
    "app:dev": "electron .",
    "dist": "electron-builder",
    "dist:mac": "electron-builder --mac dmg --arm64 --publish never"
  },
  "dependencies": {
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "fs-extra": "^11.2.0",
    "node-fetch": "^2.7.0",
    "ws": "^8.16.0"
  },
  "optionalDependencies": {
    "@jitsi/robotjs": "^0.6.13",
    "kokoro-js": "^1.2.1"
  },
  "devDependencies": {
    "electron": "^35.1.5",
    "electron-builder": "^26.0.12",
    "jsdom": "^26.1.0",
    "nodemon": "^3.0.2"
  },
  "build": {
    "appId": "com.gityus13.jarvis",
    "productName": "Jarvis",
    "afterPack": "./scripts/sign-macos.js",
    "directories": {
      "output": "dist"
    },
    "files": [
      "electron/**",
      "server.js",
      "public/**",
      "plugins/**",
      "scripts/**",
      "src/**",
      "package.json"
    ],
    "extraResources": [
      "setup-permissions.sh",
      {
        "from": "resources/macos-dictation",
        "to": "macos-dictation",
        "filter": ["**/*"]
      }
    ],
    "mac": {
      "category": "public.app-category.developer-tools",
      "extendInfo": {
        "NSMicrophoneUsageDescription": "Jarvis uses the microphone for wake-word and voice commands.",
        "NSSpeechRecognitionUsageDescription": "Jarvis recognizes your speech locally using Apple's on-device Speech framework."
      },
      "target": [
        "dmg"
      ],
      "artifactName": "Jarvis-${version}-${arch}.dmg"
    },
    "dmg": {
      "title": "Install Jarvis",
      "artifactName": "Jarvis-${version}-${arch}.dmg"
    }
  }
}
